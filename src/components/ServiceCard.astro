---
import { Film, FileText, Gamepad2, Dices, HardDrive, Calculator, Activity, Copy, ArrowUpRight, Sparkles } from 'lucide-astro';
import type { ServiceItem } from '../types/service';

interface Props {
  service: ServiceItem;
}

const { service } = Astro.props;
---

<div 
  class="service-card group relative flex flex-col justify-between p-6 sm:p-8 rounded-3xl bg-warm-surface border border-warm-border hover:border-warm-border-hover hover:shadow-card-hover transition-all duration-300"
  data-category={service.category}
  data-service-id={service.id}
  data-monitor-id={service.uptimeKumaMonitorId}
  data-keywords={service.uptimeKumaKeywords ? JSON.stringify(service.uptimeKumaKeywords) : '[]'}
>
  <div>
    <!-- Top Row: Icon & Status Indicator -->
    <div class="flex items-start justify-between gap-4 mb-5">
      <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-warm-sand border border-warm-border/80 flex items-center justify-center text-warm-charcoal group-hover:text-warm-accent group-hover:bg-warm-sand/80 transition-all shrink-0 shadow-subtle group-hover:scale-105">
        {service.icon === 'Film' && <Film class="w-7 h-7 sm:w-8 sm:h-8" />}
        {service.icon === 'FileText' && <FileText class="w-7 h-7 sm:w-8 sm:h-8" />}
        {service.icon === 'Gamepad2' && <Gamepad2 class="w-7 h-7 sm:w-8 sm:h-8" />}
        {service.icon === 'Dices' && <Dices class="w-7 h-7 sm:w-8 sm:h-8" />}
        {service.icon === 'HardDrive' && <HardDrive class="w-7 h-7 sm:w-8 sm:h-8" />}
        {service.icon === 'Calculator' && <Calculator class="w-7 h-7 sm:w-8 sm:h-8" />}
        {!['Film', 'FileText', 'Gamepad2', 'Dices', 'HardDrive', 'Calculator'].includes(service.icon) && <Activity class="w-7 h-7 sm:w-8 sm:h-8" />}
      </div>

      <div class="flex flex-col items-end gap-1.5">
        <!-- Friendly Status Pill -->
        <div 
          class="service-status-pill inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-warm-sand border border-warm-border text-warm-charcoal"
        >
          <span class="relative flex h-2.5 w-2.5">
            <span class="status-pulse-ring animate-ping absolute inline-flex h-full w-full rounded-full bg-status-online opacity-75"></span>
            <span class="status-dot relative inline-flex rounded-full h-2.5 w-2.5 bg-status-online"></span>
          </span>
          <span class="status-label">{service.isUpcoming ? 'Segera Hadir' : 'Siap Digunakan'}</span>
        </div>

        <span class="text-xs font-medium text-warm-muted">
          {service.tag}
        </span>
      </div>
    </div>

    <!-- Service Title & Subdomain Link -->
    <div>
      <div class="flex items-center gap-2">
        <h3 class="text-xl sm:text-2xl font-extrabold text-warm-charcoal tracking-tight group-hover:text-warm-accent transition-colors">
          {service.name}
        </h3>
        {service.featured && (
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-semibold bg-amber-100 text-amber-800 border border-amber-200">
            <Sparkles class="w-3 h-3" />
            Favorit
          </span>
        )}
      </div>
      <div class="text-xs font-mono text-warm-muted mt-1">
        {service.subdomain}
      </div>
    </div>

    <!-- Description (Ramah Keluarga & Jelas) -->
    <p class="mt-3.5 text-sm sm:text-base text-warm-muted leading-relaxed">
      {service.description}
    </p>

    <!-- Specs / Keunggulan Layanan -->
    {service.specs && service.specs.length > 0 && (
      <div class="mt-5 pt-4 border-t border-warm-border/50 flex flex-wrap items-center gap-2 text-xs">
        {service.specs.map((spec) => (
          <span class="px-2.5 py-1 rounded-lg bg-warm-sand/90 border border-warm-border/70 text-warm-charcoal font-medium">
            ✓ {spec}
          </span>
        ))}
      </div>
    )}
  </div>

  <!-- Bottom Actions (Tombol Lebih Besar & Nyaman Diklik) -->
  <div class="mt-8 pt-5 border-t border-warm-border/70 flex items-center justify-between gap-3">
    {service.copyText ? (
      <div class="flex items-center gap-3 w-full">
        <button 
          type="button"
          class="copy-btn flex-1 inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl text-xs sm:text-sm font-semibold bg-warm-sand text-warm-charcoal border border-warm-border hover:bg-warm-border/60 active:scale-95 transition-all cursor-pointer shadow-subtle"
          data-copy-text={service.copyText}
          data-service-name={service.name}
          title={`Salin alamat ${service.copyText}`}
        >
          <span class="copy-icon">
            <Copy class="w-4 h-4 text-warm-muted" />
          </span>
          <span class="copy-label">Salin Alamat Server</span>
        </button>

        <a 
          href={service.url}
          target="_blank"
          rel="noopener noreferrer"
          class="p-3 rounded-xl bg-warm-charcoal text-warm-bg hover:bg-warm-accent transition-colors shadow-subtle shrink-0 hover:scale-105 active:scale-95"
          title={`Buka ${service.name}`}
          aria-label={`Buka ${service.name}`}
        >
          <ArrowUpRight class="w-5 h-5" />
        </a>
      </div>
    ) : (
      <div class="flex items-center justify-between w-full">
        <span class="text-xs sm:text-sm font-medium text-warm-muted">
          100% Gratis & Bebas Iklan
        </span>

        <a 
          href={service.url}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-3 rounded-xl text-xs sm:text-sm font-bold bg-warm-charcoal text-warm-bg hover:bg-warm-accent transition-all shadow-subtle group/btn shrink-0 hover:scale-105 active:scale-95"
        >
          <span>{service.isUpcoming ? 'Lihat Layanan' : 'Buka Layanan'}</span>
          <ArrowUpRight class="w-4 h-4 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 transition-transform" />
        </a>
      </div>
    )}
  </div>
</div>
