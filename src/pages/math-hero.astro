---
import Layout from '../layouts/Layout.astro';
import { siteConfig } from '../data/services';
import { Calculator, ArrowLeft, ArrowUpRight, Smartphone, Monitor, Maximize, Star, Zap, Trophy, Brain, Target, Flame } from 'lucide-astro';

const games = [
  {
    id: 'mh1',
    number: 1,
    title: 'Math Hero 1',
    description: 'Tantangan aritmatika dasar untuk pemanasan otak. Cocok untuk semua umur dan level kemampuan.',
    url: 'https://hilmifuadi.github.io/math-hero/mh1/',
    level: 'Pemula',
    iconComponent: 'Star',
    orientation: 'portrait',
  },
  {
    id: 'mh2',
    number: 2,
    title: 'Math Hero 2',
    description: 'Level kedua dengan soal yang lebih menantang. Tingkatkan kecepatan dan ketepatan berhitungmu!',
    url: 'https://hilmifuadi.github.io/math-hero/mh2/',
    level: 'Mudah',
    iconComponent: 'Zap',
    orientation: 'portrait',
  },
  {
    id: 'mh3',
    number: 3,
    title: 'Math Hero 3',
    description: 'Tantangan semakin seru dengan variasi operasi dan waktu yang lebih ketat. Siap uji kemampuanmu?',
    url: 'https://hilmifuadi.github.io/math-hero/mh3/',
    level: 'Menengah',
    iconComponent: 'Target',
    orientation: 'portrait',
  },
  {
    id: 'mh4',
    number: 4,
    title: 'Math Hero 4',
    description: 'Level puncak dengan mode layar penuh landscape. Pengalaman bermain paling intens dan seru!',
    url: 'https://hilmifuadi.github.io/math-hero/mh4/',
    level: 'Sulit',
    iconComponent: 'Flame',
    orientation: 'landscape',
  },
];
---

<Layout title={`Math Hero — Game Matematika | ${siteConfig.siteName}`} description="Koleksi game matematika seru untuk seluruh keluarga. 4 level tantangan yang bisa langsung dimainkan di browser HP, tablet, atau laptop.">

  <!-- Breadcrumb & Back Navigation -->
  <section class="pt-6 sm:pt-8 border-b border-warm-border/60 bg-warm-bg">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <a 
        href="/" 
        class="inline-flex items-center gap-2 text-sm font-medium text-warm-muted hover:text-warm-accent transition-colors mb-6"
      >
        <ArrowLeft class="w-4 h-4" />
        <span>Kembali ke Portal</span>
      </a>
    </div>
  </section>

  <!-- Hero Section -->
  <section class="relative pt-8 pb-14 sm:pt-12 sm:pb-20 border-b border-warm-border/80 tech-grid-pattern">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl space-y-5">

        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs bg-warm-sand border border-warm-border text-warm-charcoal font-semibold shadow-subtle">
          <Calculator class="w-4 h-4 text-warm-accent" />
          <span>Game Edukasi • kubiko.my.id/math-hero</span>
        </div>

        <!-- Title -->
        <h1 class="text-3xl sm:text-5xl font-extrabold text-warm-charcoal tracking-tight leading-[1.15]">
          Math <span class="text-warm-accent">Hero</span>
        </h1>

        <!-- Description -->
        <p class="text-base sm:text-lg text-warm-muted leading-relaxed max-w-2xl font-normal">
          Koleksi game matematika yang menantang dan menyenangkan untuk seluruh anggota keluarga. 
          Pilih level sesuai kemampuan, langsung mainkan di browser — tanpa perlu pasang aplikasi!
        </p>

        <!-- Features Pills -->
        <div class="pt-2 flex flex-wrap items-center gap-y-2.5 gap-x-6 text-xs sm:text-sm text-warm-muted font-medium">
          <div class="flex items-center gap-2">
            <Smartphone class="w-4 h-4 text-warm-accent" />
            <span>Optimal di HP</span>
          </div>
          <div class="flex items-center gap-2">
            <Monitor class="w-4 h-4 text-warm-accent" />
            <span>Bisa di Laptop & Tablet</span>
          </div>
          <div class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-status-online"></span>
            <span>Gratis & Bebas Iklan</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Games Grid Section -->
  <section class="py-14 sm:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <!-- Section Header -->
      <div class="mb-10">
        <div class="inline-flex items-center gap-1.5 text-xs uppercase tracking-wider text-warm-muted mb-2 font-semibold">
          <span class="w-2 h-2 rounded-sm bg-warm-accent"></span>
          <span>Pilih Level</span>
        </div>
        <h2 class="text-2xl sm:text-4xl font-extrabold text-warm-charcoal tracking-tight">
          4 Tantangan Menanti
        </h2>
        <p class="text-sm sm:text-base text-warm-muted mt-2 max-w-xl">
          Mulai dari level pemula hingga sulit. Klik kartu untuk langsung bermain!
        </p>
      </div>

      <!-- Game Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">

        {games.map((game) => (
          <a
            href={game.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group relative flex flex-col justify-between p-6 sm:p-8 rounded-3xl bg-warm-surface border border-warm-border hover:border-warm-border-hover hover:shadow-card-hover transition-all duration-300"
          >
            <div>
              <!-- Top Row: Number Badge & Level -->
              <div class="flex items-start justify-between gap-4 mb-5">
                <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-warm-sand border border-warm-border/80 flex items-center justify-center group-hover:text-warm-accent group-hover:bg-warm-sand/80 transition-all shrink-0 shadow-subtle group-hover:scale-105">
                  {game.iconComponent === 'Star' && <Star class="w-7 h-7 sm:w-8 sm:h-8 text-warm-charcoal group-hover:text-warm-accent transition-colors" />}
                  {game.iconComponent === 'Zap' && <Zap class="w-7 h-7 sm:w-8 sm:h-8 text-warm-charcoal group-hover:text-warm-accent transition-colors" />}
                  {game.iconComponent === 'Target' && <Target class="w-7 h-7 sm:w-8 sm:h-8 text-warm-charcoal group-hover:text-warm-accent transition-colors" />}
                  {game.iconComponent === 'Flame' && <Flame class="w-7 h-7 sm:w-8 sm:h-8 text-warm-charcoal group-hover:text-warm-accent transition-colors" />}
                </div>

                <div class="flex flex-col items-end gap-1.5">
                  <!-- Level Badge -->
                  <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-semibold bg-warm-sand border border-warm-border text-warm-charcoal">
                    <span class="relative flex h-2.5 w-2.5">
                      <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-status-online opacity-75"></span>
                      <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-status-online"></span>
                    </span>
                    <span>Level {game.number}</span>
                  </div>

                  <span class="text-xs font-medium text-warm-muted">
                    {game.level}
                  </span>
                </div>
              </div>

              <!-- Title -->
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="text-xl sm:text-2xl font-extrabold text-warm-charcoal tracking-tight group-hover:text-warm-accent transition-colors">
                    {game.title}
                  </h3>
                  {game.number === 4 && (
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-semibold bg-amber-100 text-amber-800 border border-amber-200">
                      <Maximize class="w-3 h-3" />
                      Fullscreen
                    </span>
                  )}
                </div>
                <div class="text-xs font-mono text-warm-muted mt-1">
                  hilmifuadi.github.io/math-hero/mh{game.number}/
                </div>
              </div>

              <!-- Description -->
              <p class="mt-3.5 text-sm sm:text-base text-warm-muted leading-relaxed">
                {game.description}
              </p>

              <!-- Specs -->
              <div class="mt-5 pt-4 border-t border-warm-border/50 flex flex-wrap items-center gap-2 text-xs">
                <span class="px-2.5 py-1 rounded-lg bg-warm-sand/90 border border-warm-border/70 text-warm-charcoal font-medium">
                  ✓ Main di Browser
                </span>
                <span class="px-2.5 py-1 rounded-lg bg-warm-sand/90 border border-warm-border/70 text-warm-charcoal font-medium">
                  ✓ Optimal di HP
                </span>
                {game.orientation === 'landscape' ? (
                  <span class="px-2.5 py-1 rounded-lg bg-amber-50 border border-amber-200 text-amber-800 font-medium">
                    ⟳ Mode Landscape
                  </span>
                ) : (
                  <span class="px-2.5 py-1 rounded-lg bg-warm-sand/90 border border-warm-border/70 text-warm-charcoal font-medium">
                    ✓ Mode Portrait
                  </span>
                )}
              </div>
            </div>

            <!-- Bottom Action -->
            <div class="mt-8 pt-5 border-t border-warm-border/70 flex items-center justify-between gap-3">
              <span class="text-xs sm:text-sm font-medium text-warm-muted">
                Gratis & Bebas Iklan
              </span>

              <span class="inline-flex items-center gap-2 px-5 py-3 rounded-xl text-xs sm:text-sm font-bold bg-warm-charcoal text-warm-bg group-hover:bg-warm-accent transition-all shadow-subtle shrink-0 group-hover:scale-105 active:scale-95">
                <span>Main Sekarang</span>
                <ArrowUpRight class="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
              </span>
            </div>
          </a>
        ))}

      </div>

      <!-- Credits Note -->
      <div class="mt-12 p-5 rounded-2xl bg-warm-sand/60 border border-warm-border text-center">
        <p class="text-xs sm:text-sm text-warm-muted leading-relaxed">
          <Brain class="w-4 h-4 inline-block text-warm-accent -mt-0.5 mr-1" />
          <strong class="text-warm-charcoal">Math Hero</strong> dikembangkan oleh 
          <a href="https://github.com/hilmifuadi" target="_blank" rel="noopener noreferrer" class="text-warm-accent hover:underline font-semibold">hilmifuadi</a> 
          dan diintegrasikan ke portal <strong class="text-warm-charcoal">Kubiko</strong> untuk kenyamanan seluruh keluarga.
        </p>
      </div>

    </div>
  </section>

</Layout>
